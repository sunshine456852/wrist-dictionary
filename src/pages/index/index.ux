<template>
  <div class="page page-{{screenProfile}}">
    <text class="title title-{{screenProfile}}">腕上词典</text>

    <div class="spacer"></div>

    <div class="icon-card icon-card-{{screenProfile}}" @click="goSettings">
      <img class="deco-icon deco-icon-{{screenProfile}}" src="/common/deco-icon.png" />
    </div>

    <div class="button-group button-group-{{screenProfile}}">
      <div
        class="main-button main-button-{{screenProfile}} secondary-button"
        @click="goInflectSearch"
      >
        <img class="btn-icon btn-icon-{{screenProfile}}" src="/common/icons/btn_transform.png" />
        <text class="btn-label">查找变形</text>
      </div>
      <div class="main-button main-button-{{screenProfile}} secondary-button" @click="goSearch">
        <img class="btn-icon btn-icon-{{screenProfile}}" src="/common/icons/btn_search.png" />
        <text class="btn-label">中英查找</text>
      </div>
      <div class="main-button main-button-{{screenProfile}} secondary-button" @click="goHistory">
        <img class="btn-icon btn-icon-{{screenProfile}}" src="/common/icons/btn_history.png" />
        <text class="btn-label">历史记录</text>
      </div>
      <div class="main-button main-button-{{screenProfile}} secondary-button" @click="goFavorites">
        <img class="btn-icon btn-icon-{{screenProfile}}" src="/common/icons/btn_fav.png" />
        <text class="btn-label">我的收藏</text>
      </div>
    </div>

    <div class="spacer"></div>

    <div class="bottom-row bottom-row-{{screenProfile}}">
      <div class="small-button small-button-{{screenProfile}} about-button" @click="goAbout">
        <img class="btn-icon-sm" src="/common/icons/btn_about.png" />
        <text class="btn-label-sm">关于</text>
      </div>
    </div>
  </div>
</template>

<script>
import device from "@system.device"
import storage from "@system.storage"
import router from "@system.router"
import buildTarget from "../../common/buildTarget"

export default {
  private: {
    screenProfile: buildTarget.profile
  },

  onInit() {
    const app = this.$app.$def
    this.screenProfile = buildTarget.profile
    device.getInfo({
      success: (data) => {
        app.updateScreenInfo(data)
        this.screenProfile = app.data.screenProfile
      },
      fail: (data, code) => {
        
      }
    })
    this._cleanInvalidHistory()
    this._trackLaunch()
  },

  _trackLaunch() {
    storage.get({
      key: "dic_launch_count",
      default: "0",
      success: (data) => {
        var raw = data && (data.value || data)
        var count = parseInt(raw, 10)
        if (!isFinite(count) || count < 0) {
          count = 0
        }
        var nextCount = count + 1
        storage.set({
          key: "dic_launch_count",
          value: String(nextCount),
          fail: (setData, code) => {
            
          }
        })

      },
      fail: (getData, code) => {
        console.log("index launch count read failed: " + code)
      }
    })
  },

  _cleanInvalidHistory() {
    storage.get({
      key: "dic_history",
      success: function(data) {
        var text = data && (data.value || data)
        if (!text) return
        var list
        try { list = JSON.parse(text) } catch (e) { return }
        if (!list || !list.length) return

        var clean = []
        for (var i = 0; i < list.length; i++) {
          var item = list[i]
          // Keep only entries with valid query AND cached ids (drop old format)
          if (item && item.query && item.query.toString().trim() && item.ids && item.ids.length > 0) {
            clean.push(item)
          }
        }

        if (clean.length < list.length) {
          storage.set({
            key: "dic_history",
            value: JSON.stringify(clean)
          })
        }
      },
      fail: function() {}
    })
  },

  goInflectSearch() {
    router.push({
      uri: "/pages/search",
      params: {
        searchMode: "inflect",
        inflectDepth: "0"
      }
    })
  },

  goSearch() {
    router.push({
      uri: "/pages/search"
    })
  },

  goSettings() {
    router.push({
      uri: "/pages/settings"
    })
  },

  goHistory() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "history"
      }
    })
  },

  goFavorites() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "favorites"
      }
    })
  },

  goAbout() {
    router.push({
      uri: "/pages/about"
    })
  },


}
</script>


